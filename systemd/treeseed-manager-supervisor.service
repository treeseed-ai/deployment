[Unit]
Description=TreeSeed privileged host supervisor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=treeseed-operators
SupplementaryGroups=treeseed-manager
RuntimeDirectory=treeseed/manager
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=restart
ExecStartPre=/usr/bin/install -d -o root -g treeseed-operators -m 0770 /run/treeseed/manager
ExecStart=/usr/lib/treeseed/runtime/bin/node /usr/lib/treeseed/manager/dist/src/bin/supervisor.js
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
# Development hosts may select a validated workspace-visible .treeseed/data root.
# The supervisor protocol remains a strict allowlist and validates that root.
ProtectHome=no
ProtectSystem=strict
ReadWritePaths=/etc/treeseed /var/lib/treeseed /run/treeseed /run/lock /etc/apt/sources.list.d /var/lib/apt /var/cache/apt /var/lib/dpkg /var/log/apt

[Install]
WantedBy=multi-user.target
