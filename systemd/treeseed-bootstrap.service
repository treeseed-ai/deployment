[Unit]
Description=TreeSeed generic asynchronous host bootstrap foundation
After=network-online.target apt-daily.service apt-daily-upgrade.service
Wants=network-online.target
ConditionPathExists=!/var/lib/treeseed/bootstrap/foundation.complete
ConditionPathExists=!/etc/treeseed/platform.json
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/treeseed/bootstrap/bootstrap.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
