[Unit]
Description=TreeSeed configured asynchronous host bootstrap
After=network-online.target apt-daily.service apt-daily-upgrade.service
Wants=network-online.target
ConditionPathExists=!/var/lib/treeseed/bootstrap/handoff.complete
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/treeseed/bootstrap/bootstrap.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
