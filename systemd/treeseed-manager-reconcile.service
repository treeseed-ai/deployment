[Unit]
Description=Converge TreeSeed managed host state
After=treeseed-manager-supervisor.service docker.service
Requires=treeseed-manager-supervisor.service

[Service]
Type=oneshot
User=treeseed-manager
Group=treeseed-manager
ExecStart=/usr/lib/treeseed/runtime/bin/node /usr/lib/treeseed/manager/dist/src/bin/reconcile.js
TimeoutStartSec=1h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/treeseed/manager /run/treeseed/manager
