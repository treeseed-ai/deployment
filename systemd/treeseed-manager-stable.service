[Unit]
Description=Check and conditionally activate stable TreeSeed updates
After=treeseed-manager-supervisor.service docker.service
Requires=treeseed-manager-supervisor.service

[Service]
Type=oneshot
User=treeseed-manager
Group=treeseed-manager
ExecStart=/usr/lib/treeseed/runtime/bin/node /usr/lib/treeseed/manager/dist/src/bin/reconcile.js --track=stable
TimeoutStartSec=1h
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/treeseed/manager /run/treeseed/manager
