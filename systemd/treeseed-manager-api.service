[Unit]
Description=TreeSeed manager mutual-TLS API
After=treeseed-manager-supervisor.service network-online.target
Requires=treeseed-manager-supervisor.service

[Service]
Type=simple
User=treeseed-manager
Group=treeseed-manager
ExecStart=/usr/lib/treeseed/runtime/bin/node /usr/lib/treeseed/manager/dist/src/bin/api.js
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/treeseed/manager /run/treeseed/manager

[Install]
WantedBy=multi-user.target
