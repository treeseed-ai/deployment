[Unit]
Description=Apply one validated TreeSeed APT transaction
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/lib/treeseed/runtime/bin/node /usr/lib/treeseed/manager/dist/src/bin/apt-helper.js
TimeoutStartSec=1h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=false
