#!/bin/sh
set -eu
getent group treeseed-manager >/dev/null || addgroup --system treeseed-manager
getent passwd treeseed-manager >/dev/null || adduser --system --ingroup treeseed-manager --home /var/lib/treeseed/manager --no-create-home treeseed-manager
getent group treeseed-operators >/dev/null || addgroup --system treeseed-operators
getent group treeseed-component-secrets >/dev/null || addgroup --system treeseed-component-secrets
install -d -o root -g root -m 0711 /etc/treeseed /var/lib/treeseed
install -d -o root -g treeseed-manager -m 0750 /etc/treeseed/manager /etc/treeseed/manager/tls
install -d -o root -g treeseed-operators -m 0770 /run/treeseed/manager
install -d -o root -g treeseed-manager -m 0750 /etc/treeseed/sandbox /run/treeseed/sandbox
for unit in treeseed-manager-supervisor treeseed-manager-api treeseed-sandbox-broker treeseed-manager-reconcile treeseed-manager-stable treeseed-manager-development; do
	install -d -o root -g root -m 0755 "/etc/systemd/system/$unit.service.d"
done
install -d -o root -g root -m 0755 /etc/cni/net.d
install -d -o root -g root -m 0755 /opt/cni/bin
for plugin in bridge firewall host-local; do
	ln -sfn "/usr/lib/cni/$plugin" "/opt/cni/bin/$plugin"
done
install -d -o root -g root -m 0700 /var/lib/treeseed/sandboxes /var/lib/treeseed/encrypted /var/lib/cni
install -d -o treeseed-manager -g treeseed-manager -m 0750 /var/lib/treeseed/manager /var/lib/treeseed/manager/receipts
install -d -o root -g treeseed-component-secrets -m 0710 /var/lib/treeseed/component-secrets
chown -R treeseed-manager:treeseed-manager /var/lib/treeseed/manager
touch /var/lib/treeseed/manager/events.jsonl
chown treeseed-manager:treeseed-manager /var/lib/treeseed/manager/events.jsonl
chmod 0660 /var/lib/treeseed/manager/events.jsonl
if [ -f /etc/treeseed/platform.json ]; then chown root:treeseed-manager /etc/treeseed/platform.json; chmod 0640 /etc/treeseed/platform.json; fi
systemctl daemon-reload
systemctl enable treeseed-manager-supervisor.service treeseed-provider-volume.service treeseed-sandbox-broker.service treeseed-manager-api.service >/dev/null
if [ -f /etc/treeseed/platform.json ]; then
	systemctl enable treeseed-manager-stable.timer treeseed-manager-development.timer >/dev/null
	systemctl restart treeseed-manager-stable.timer treeseed-manager-development.timer
else
	systemctl disable --now treeseed-manager-stable.timer treeseed-manager-development.timer >/dev/null 2>&1 || true
fi
exit 0
