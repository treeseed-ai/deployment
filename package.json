{
  "name": "@treeseed-cordis/deployment",
  "version": "0.0.0-cordis.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "types": "./dist/src/diagnose.d.ts",
      "default": "./dist/src/diagnose.js"
    },
    "./testing": {
      "types": "./dist/tests/release-fixture.d.ts",
      "default": "./dist/tests/release-fixture.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "dist/tests/release-fixture.*"
  ],
  "scripts": {
    "check": "bun scripts/tooling.ts check",
    "build": "bun scripts/tooling.ts build",
    "test:unit": "bun test ./tests --test-name-pattern '^unit:'",
    "test:integration": "bun test ./tests --test-name-pattern '^integration:'",
    "test:smoke": "bun test ./tests --test-name-pattern '^smoke:'",
    "verify": "bun run check && bun run build && bun run test:unit && bun run test:integration && bun run test:smoke"
  },
  "peerDependencies": {
    "@treeseed-cordis/sdk": "0.0.0-cordis.2"
  },
  "devDependencies": {
    "@treeseed-cordis/sdk": "file:vendor/sdk.tgz",
    "typescript": "5.9.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "@types/semver": "7.8.0"
  },
  "cordisCandidate": {
    "sdk": {
      "repository": "https://github.com/treeseed-ai/sdk.git",
      "commit": "74e81bed406c3ee7d7c866d647cdc49a8a0d95f5",
      "sha256": "f6b892a0a27fac37d5c1742bbbf7d58b7a8f6d320019d3d244c03173042f73dd"
    }
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "tar": "7.5.22",
    "semver": "7.8.5"
  }
}
