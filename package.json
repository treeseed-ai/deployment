{
  "name": "@treeseed/deployment",
  "version": "0.1.0-rc.220",
  "private": true,
  "description": "TreeSeed host bootstrap, deployment manager, edge, and Debian packaging",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./infrastructure/opentofu": {
      "types": "./dist/src/infrastructure/opentofu/index.d.ts",
      "import": "./dist/src/infrastructure/opentofu/index.js"
    }
  },
  "files": [
    "dist/src/**",
    "infrastructure/opentofu/hosted-topology/**",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package:runtime": "node --import tsx scripts/package-runtime.ts",
    "check:source-shape": "node --import tsx scripts/check-source-shape.ts",
    "test": "vitest run",
    "verify:direct": "npm run check:source-shape && npm run build && npm test && npm run verify:opentofu",
    "verify:opentofu": "node --import tsx scripts/verify-opentofu.ts",
    "artifacts:fetch": "node --import tsx scripts/fetch-artifacts.ts",
    "artifacts:prepare": "npm run artifacts:fetch && node --import tsx scripts/prepare-artifacts.ts",
    "verify:treeai-activation": "node --import tsx scripts/verify-treeai-activation.ts",
    "build:deb": "npm run artifacts:prepare && npm run build && node --import tsx scripts/package-deb.ts all",
    "verify:deb": "npm run build:deb && npm run package:runtime && node --import tsx scripts/verify-deb.ts",
    "catalog:compile": "node --import tsx scripts/compile-catalog.ts",
    "r2-replication:provision": "node --import tsx scripts/provision-r2-replication.ts"
  },
  "dependencies": {
    "@treeseed/sdk": "0.13.0-rc.75",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
