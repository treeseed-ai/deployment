                      "$context": "originAuthority"
                    },
                    "\n header_up X-Forwarded-Port ",
                    {
                      "$context": "originPort"
                    },
                    "\n }\n }\n handle /identity/* {\n respond 404\n }\n handle {\n reverse_proxy ",
