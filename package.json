        "entry": "dist/src/service-caddy.js",
        "classExport": "CaddyServicePlugin",
        "configurationSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "replacement": {
          "kind": "restart",
          "stateVersion": 1,
          "qualificationDigest": null
        },
        "commandIds": [],
        "container": {
          "definition": {
            "imageId": "caddy",
            "user": "image-default",
            "environment": {},
            "ports": [
              {
                "id": "https",
                "target": 443
              }
            ],
            "volumes": [
              {
                "source": "data",
                "target": "/data",
                "readOnly": false
              },
              {
                "source": "config",
                "target": "/config",
                "readOnly": false
              }
            ],
            "secrets": [
              {
                "slot": "edge-config",
                "target": "/etc/caddy/Caddyfile"
              }
            ],
            "workerSocket": false
          },
          "resources": {
            "volumes": [
              "data",
              "config"
            ],
            "slots": {
              "edge-config": {
                "kind": "text",
                "value": {
                  "$template": [
                    "{\n admin off\n auto_https disable_redirects\n skip_install_trust\n}\nhttps://",
                    {
                      "$context": "hostname"
                    },
                    ":443 {\n tls internal\n @identity path /identity/realms/cordis/* /identity/resources/*\n handle @identity {\n reverse_proxy ",
                    {
                      "$endpoint": {
                        "dependencyPort": "identity",
                        "portId": "http",
                        "scheme": "http",
                        "path": "/",
                        "part": "authority"
                      }
                    },
                    " {\n header_up -Forwarded\n header_up X-Forwarded-Proto https\n header_up X-Forwarded-Host ",
                    {
                      "$context": "originAuthority"
                    },
                    "\n header_up X-Forwarded-Port ",
                    {
                      "$context": "originPort"
                    },
                    "\n }\n }\n handle /identity/* {\n respond 404\n }\n handle {\n reverse_proxy ",
                    {
                      "$endpoint": {
                        "dependencyPort": "api",
                        "portId": "http",
                        "scheme": "http",
                        "path": "/",
                        "part": "authority"
                      }
                    },
                    "\n }\n}\n"
                  ]
                }
              }
            },
            "grants": [],
            "authorities": [
              {
                "id": "public-ca",
                "volume": "data",
                "path": "caddy/pki/authorities/local/root.crt"
              }
            ]
          },
          "providedContracts": [
            {
              "port": "https",
              "contractId": "edge.https",
              "contractVersion": "1.0.0"
            }
          ],
          "dependencies": [
            {
              "port": "api",
              "contractId": "platform.api",
              "contractVersion": "1.0.0"
            },
            {
              "port": "identity",
              "contractId": "identity.oidc",
              "contractVersion": "1.0.0"
            }
          ],
          "observationContract": "edge.https",
          "transitionPolicy": {
            "kind": "restart-required",
            "stateVersion": 1
          }
        }
      },
